# Data: only data/README.md and data/sample/ are tracked (course rule: no large datasets in git)
data/raw/*
data/processed/*
data/splits/*
data/subsets/*
!data/splits/.gitkeep
!data/subsets/.gitkeep
external_data/
raha-master/
TableEG/
!data/raw/.gitkeep
!data/processed/.gitkeep
*.zip
*.tar.gz
*.parquet

# Models: weights live on the Hugging Face Hub, never in git
models/checkpoints/*
!models/checkpoints/.gitkeep
*.safetensors
*.pt
*.pth
*.bin

# Run outputs, predictions and temporary logs (summary tables go to docs/tables/m3_*.csv)
outputs/runs/*
outputs/predictions/*
!outputs/predictions/.gitkeep

# Python / environments
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/

# Secrets, local notes and OS files
.env
.DS_Store
.vscode/
.idea/
*.swp
*~
